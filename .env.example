# Backblaze B2 (required) — S3-compatible API.
# The S3 endpoint is derived from B2_REGION as https://s3.{B2_REGION}.backblazeb2.com,
# so there is never a hardcoded region in the source.
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your_region

# Optional: public base URL for the bucket (for public buckets / a CDN in front).
# Leave unset for private buckets — the app uses presigned URLs for previews.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.your_region.backblazeb2.com

# Example of what filled-in values look like (illustrative only):
# B2_APPLICATION_KEY_ID=000000000000000000000000
# B2_APPLICATION_KEY=your-secret-application-key
# B2_BUCKET_NAME=my-moderation-bucket
# B2_REGION=us-west-004

# --- Moderation pipeline (app-specific, non-secret) ---
# Default safety threshold: an image is quarantined when score >= threshold
# (score is 0..1, 1 = most NSFW). 0.70 == the "Balanced" preset in the UI.
MODERATION_DEFAULT_THRESHOLD=0.70
# CLIP backbone + pretrained weights for the image-embedding stage.
CLIP_MODEL_NAME=ViT-L-14
CLIP_PRETRAINED=openai
# Where the LAION AutoKeras NSFW SavedModel is cached (relative to services/api).
NSFW_MODEL_DIR=models
# Torch device for CLIP: "auto" picks CUDA -> Apple MPS -> CPU. The TensorFlow
# classifier always runs on CPU. Never hard-requires a GPU.
MODERATION_DEVICE=auto

# Frontend -> API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
